{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/api-evangelist/eliq/main/json-schema/eliq-advice-schema.json",
  "title": "Advice",
  "description": "Model containing advice information.",
  "x-generated": "2026-10-20",
