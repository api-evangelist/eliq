      "description": "A list of available estimated savings in either kWh or M3, depending on whether the advice is intended\nfor gas or electricity fuel."
    },
    "estimated_yearly_savings_cost": {
      "type": [
        "number",
        "null"
      ],
      "description": "Estimated savings in cost. Currency is the same as price formula currency.\n\nDeprecated property, estimated_yearly_savings_monetary should be used instead.",
